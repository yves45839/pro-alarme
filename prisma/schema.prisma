generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum AlarmDeviceStatus {
  PENDING_INSTALLATION
  INSTALLED
  MAINTENANCE
  RETIRED
}

enum TechnicianVisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageCategory {
  FORM_WELCOME
  INSTALLATION
  SUBSCRIPTION_REMINDER_5D
  SUBSCRIPTION_REMINDER_2D
  SUBSCRIPTION_REMINDER_DAY
  RENEWAL_CONFIRMATION
  CUSTOM
}

enum PaymentType {
  DEPOSIT
  PAYOUT
  REFUND
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum UserRole {
  ADMIN
  SUPPORT
}

model Prospect {
  id          String         @id @default(cuid())
  phoneNumber String         @unique
  fullName    String?
  email       String?
  location    String?
  source      String?
  status      ProspectStatus @default(NEW)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  convertedAt DateTime?

  customerPhoneNumber String?  @unique
  customer            Customer? @relation("ProspectCustomer", fields: [customerPhoneNumber], references: [phoneNumber], onDelete: SetNull, onUpdate: Cascade)

  messages MessageLog[] @relation("ProspectMessages")
}

model Customer {
  phoneNumber         String      @id
  fullName            String?
  email               String?
  location            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  firstSubscriptionAt DateTime?
  notes               String?

  prospect Prospect? @relation("ProspectCustomer")

  subscriptions  Subscription[]
  alarmDevices   AlarmDevice[]
  technicianJobs TechnicianVisit[]
  messages       MessageLog[] @relation("CustomerMessages")
}

model Subscription {
  id                    String             @id @default(cuid())
  customerPhoneNumber   String
  productName           String
  planName              String?
  status                SubscriptionStatus @default(ACTIVE)
  startDate             DateTime           @default(now())
  endDate               DateTime?
  renewalDate           DateTime?
  firstSubscribedAt     DateTime?
  lastRenewedAt         DateTime?
  reminder5DaysSentAt   DateTime?
  reminder2DaysSentAt   DateTime?
  reminderSameDaySentAt DateTime?
  amount                Decimal?           @db.Decimal(12, 2)
  alarmCentralSerial    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  customer Customer      @relation(fields: [customerPhoneNumber], references: [phoneNumber], onDelete: Restrict, onUpdate: Cascade)
  devices  AlarmDevice[]
  messages MessageLog[]  @relation("SubscriptionMessages")
  payments PaymentTransaction[]

  @@index([customerPhoneNumber])
  @@index([status])
  @@index([renewalDate])
}

model AlarmDevice {
  id                  String            @id @default(cuid())
  serialNumber        String            @unique
  model               String?
  status              AlarmDeviceStatus @default(PENDING_INSTALLATION)
  installedAt         DateTime?
  location            String?
  notes               String?
  customerPhoneNumber String
  subscriptionId      String?

  customer     Customer      @relation(fields: [customerPhoneNumber], references: [phoneNumber], onDelete: Restrict, onUpdate: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  visits       TechnicianVisit[]

  @@index([customerPhoneNumber])
  @@index([subscriptionId])
}

model TechnicianVisit {
  id                  String                 @id @default(cuid())
  customerPhoneNumber String
  alarmDeviceId       String?
  scheduledFor        DateTime
  status              TechnicianVisitStatus  @default(SCHEDULED)
  technicianName      String?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  customer Customer     @relation(fields: [customerPhoneNumber], references: [phoneNumber], onDelete: Restrict, onUpdate: Cascade)
  device   AlarmDevice? @relation(fields: [alarmDeviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages MessageLog[] @relation("TechnicianVisitMessages")

  @@index([customerPhoneNumber])
  @@index([alarmDeviceId])
  @@index([scheduledFor])
}

model MessageLog {
  id                  String           @id @default(cuid())
  phoneNumber         String
  direction           MessageDirection
  category            MessageCategory
  channel             String           @default("SMS")
  content             String
  status              String           @default("SENT")
  sentAt              DateTime         @default(now())
  deliveryStatus      String?
  metadata            Json?
  prospectId          String?
  customerPhoneNumber String?
  subscriptionId      String?
  technicianVisitId   String?

  prospect        Prospect?        @relation("ProspectMessages", fields: [prospectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer        Customer?        @relation("CustomerMessages", fields: [customerPhoneNumber], references: [phoneNumber], onDelete: SetNull, onUpdate: Cascade)
  subscription    Subscription?    @relation("SubscriptionMessages", fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  technicianVisit TechnicianVisit? @relation("TechnicianVisitMessages", fields: [technicianVisitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phoneNumber])
  @@index([category])
  @@index([customerPhoneNumber])
  @@index([subscriptionId])
  @@index([technicianVisitId])
}

model PaymentTransaction {
  id                String           @id @default(cuid())
  type              PaymentType
  direction         PaymentDirection
  status            PaymentStatus    @default(PENDING)
  amount            Decimal          @db.Decimal(12, 2)
  currency          String
  msisdn            String
  providerReference String?          @unique
  customerReference String           @unique
  description       String?
  rawPayload        Json?
  errorMessage      String?
  subscriptionId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status], map: "payment_status_idx")
  @@index([subscriptionId], map: "payment_subscription_idx")
  @@index([msisdn], map: "payment_msisdn_idx")
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  hashedPassword String?
  role           UserRole   @default(ADMIN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
